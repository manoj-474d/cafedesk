# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive Bengaluru map & Places discovery.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Optional server-only Google Places API (New) key used by backend /api/places/* proxy routes.
# Falls back to VITE_GOOGLE_MAPS_API_KEY if omitted.
GOOGLE_PLACES_API_KEY=""


# SESSION_SECRET: Secret key used to sign session tokens (set a strong random string in production).
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Optional one-time initial admin bootstrap credentials (leave empty to configure via /admin/login on first run).
ADMIN_BOOTSTRAP_USER=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional Razorpay checkout credentials for live UPI/Card/NetBanking subscription payments.
# When omitted, Cafe Desk uses an explicit server-signed Razorpay-compatible test checkout flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# Optional backend origin URL when hosting the frontend on a static CDN separately from server.ts.
VITE_API_BASE_URL=""

# Optional Google Identity Services Client ID for customer "Continue with Google" sign-in.
VITE_GOOGLE_CLIENT_ID=""

# Supabase Connection (Client-safe public credentials + Optional Server-only service role key)
# NEVER prefix SUPABASE_SERVICE_ROLE_KEY with VITE_ or expose it in frontend code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

